# SolarMesh backend environment (copy to .env and adjust)

# Database: SQLite default (zero setup) or PostgreSQL for production
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/solarmesh

# Security — MUST be changed for any real deployment
SECRET_KEY=dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Digital-twin simulation
SIMULATION_INTERVAL_SECONDS=4.0

# Matching engine
MATCH_INTERVAL_SECONDS=5
MAX_ORDER_AGE_HOURS=48
ENERGY_PRICE_FLOOR=0.05
ENERGY_PRICE_CEIL=0.50
GRID_LOSS_FACTOR=0.02
CONGESTION_PENALTY=0.15
